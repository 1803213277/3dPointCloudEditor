    <ProjectName>3dPointCloudEditor</ProjectName>
    <RootNamespace>PointCloudEditor</RootNamespace>
    <!--
      $(TargetName) should be same as $(RootNamespace) so that the produced binaries (.exe/.pri/etc.)
      have a name that matches the .winmd
    -->
    <TargetName>3dPointCloudEditor</TargetName>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <AppContainerApplication>false</AppContainerApplication>
    <!--
      ========================================================================
      普通（非打包）Windows 桌面应用，而不是 MSIX / Microsoft Store 应用。
      ========================================================================
      WindowsPackageType=None
          不生成 MSIX 包，也不需要“应用包身份”（package identity）即可启动，
          因此构建出来的 exe 可以直接双击运行。
      AppxPackage=false
          关闭 Appx 打包管线（不再生成 AppxManifest.xml / .appxrecipe / MSIX）。
      WindowsAppSDKSelfContained=true
          把 Windows App SDK 运行时（WinUI、WindowsAppRuntime 等 DLL）复制到输出目录，
          目标机器不需要预装 Windows App Runtime 就能双击运行。
          代价是输出目录会有上百个 DLL（约 120 MB），分发时整个目录一起拷贝。
      ========================================================================
      注意：ApplicationType / ApplicationTypeRevision / EnableMsixTooling 必须保留。
      Visual Studio 的 C++ XAML 工具链（MarkupCompilePass1、App.xaml.g.h 生成、
      resources.pri 生成）靠这几个属性挂接；删掉它们会编译失败（找不到 App.xaml.g.h）。
      它们只影响构建管线，不会让输出变成 MSIX 包——是否打包只由 WindowsPackageType
      和 AppxPackage 决定。Visual Studio 里因此仍会显示“发布(Package and Publish)”
      菜单项，但普通 F5 / 生成得到的仍是可双击的 exe。
      ========================================================================
      如果想恢复成 MSIX 打包（例如要上架 Microsoft Store），把下面三行改成：
          <WindowsPackageType>MSIX</WindowsPackageType>
          <AppxPackage>true</AppxPackage>
          <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
      并确认 Package.appxmanifest 仍然存在。
    -->
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      显式指定输出目录，让 exe、resources.pri 和运行时 DLL 直接平铺在
        <仓库根>\x64\Release\     （Debug 则为 x64\Debug\）
      而不是被 Windows Store 项目默认的“每项目一个子目录”规则塞进
        x64\Release\3dPointCloudEditor\  （见 Microsoft.Cpp.AppContainerApplication.props）。
      显式设置 OutDir 会让 MSBuild 认为“用户已指定输出目录”，从而跳过那条规则。
      命令行构建和 Visual Studio 构建（解决方案在仓库根）都会得到同一个位置。
    -->
    <OutDir>$(MSBuildProjectDirectory)\..\$(Platform)\$(Configuration)\</OutDir>
  </PropertyGroup>
