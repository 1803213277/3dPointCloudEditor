  <!--
    窗口 / 任务栏图标：App.xaml.cpp 会加载 exe 同目录下的 app.ico（存在时通过
    AppWindow.SetIcon 应用）。非打包构建不会像 MSIX 那样自动带上这个文件，
    因此构建完成后把它复制到输出目录。
  -->
  <Target Name="CopyAppIconToOutput" AfterTargets="Build" Condition="Exists('$(ProjectDir)app.ico')">
    <Copy SourceFiles="$(ProjectDir)app.ico" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <!--
    内置示例点云：把仓库根目录的 samples\ 复制到输出目录的 samples\，
    供工具栏「示例点云」下拉菜单直接打开（4 个文件的 PLY/PCD 编码各不相同）。
  -->
  <Target Name="CopySampleCloudsToOutput" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\samples')">
    <ItemGroup>
      <_SampleCloudFile Include="$(MSBuildProjectDirectory)\..\samples\*.ply" />
      <_SampleCloudFile Include="$(MSBuildProjectDirectory)\..\samples\*.pcd" />
    </ItemGroup>
    <Copy SourceFiles="@(_SampleCloudFile)" DestinationFolder="$(OutDir)samples" SkipUnchangedFiles="true" />
  </Target>
</Project>