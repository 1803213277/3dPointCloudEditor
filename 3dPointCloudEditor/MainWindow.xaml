<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PointCloudEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PointCloudEditor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部菜单栏 -->
        <MenuBar Grid.Row="0"
                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                 BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                 BorderThickness="0,0,0,1">
            <MenuBarItem x:Name="MenuFile" Title="文件">
                <MenuFlyoutItem x:Name="MenuOpenItem" Text="打开点云文件…" Click="OnMenuOpenClick" />
                <MenuFlyoutItem x:Name="MenuSavePlyItem" Text="保存 PLY 文件…" Click="OnMenuSaveClick" />
                <MenuFlyoutItem x:Name="MenuSavePcdItem" Text="保存 PCD 文件…" Click="OnMenuSavePcdClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuExitItem" Text="退出" Click="OnMenuExitClick" />
            </MenuBarItem>
            <MenuBarItem x:Name="MenuEdit" Title="编辑">
                <MenuFlyoutItem x:Name="MenuSelectModeItem" Text="点云选择模式" Click="OnMenuSelectModeClick" />
                <MenuFlyoutItem x:Name="MenuDeleteItem" Text="删除选中的点云" Click="OnMenuDeletePointsClick" />
                <MenuFlyoutItem x:Name="MenuClearSelectItem" Text="清除选择" Click="OnMenuClearSelectionClick" />
            </MenuBarItem>
            <MenuBarItem x:Name="MenuView" Title="视图">
                <MenuFlyoutItem x:Name="MenuResetViewItem" Text="重置视角" Click="OnMenuResetViewClick" />
            </MenuBarItem>
            <MenuBarItem x:Name="MenuLanguage" Title="语言">
                <ToggleMenuFlyoutItem x:Name="LangChineseItem" Text="中文" Click="OnLanguageChineseClick" />
                <ToggleMenuFlyoutItem x:Name="LangEnglishItem" Text="English" Click="OnLanguageEnglishClick" />
            </MenuBarItem>
            <MenuBarItem x:Name="MenuTheme" Title="主题">
                <ToggleMenuFlyoutItem x:Name="ThemeSystemItem" Text="跟随系统" Click="OnThemeSystemClick" />
                <ToggleMenuFlyoutItem x:Name="ThemeLightItem" Text="浅色" Click="OnThemeLightClick" />
                <ToggleMenuFlyoutItem x:Name="ThemeDarkItem" Text="深色" Click="OnThemeDarkClick" />
            </MenuBarItem>

            <MenuBarItem x:Name="MenuHelp" Title="帮助">
                <MenuFlyoutItem x:Name="MenuAboutItem" Text="关于" Click="OnMenuAboutClick" />
            </MenuBarItem>
        </MenuBar>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="1"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OpenButton"
                            Content="打开点云文件…"
                            Style="{StaticResource AccentButtonStyle}" />
                    <DropDownButton x:Name="DemoButton"
                                    Grid.Column="1"
                                    Content="示例点云">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem x:Name="DemoSphereItem" Text="球体（PLY ASCII）" />
                                <MenuFlyoutItem x:Name="DemoWaveItem" Text="波浪曲面（PLY 二进制小端）" />
                                <MenuFlyoutItem x:Name="DemoHelixItem" Text="螺旋线（PLY 二进制大端）" />
                                <MenuFlyoutItem x:Name="DemoTorusItem" Text="环面（PCD）" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="SaveFileButton"
                            Grid.Column="2"
                            Content="保存 PLY…"
                            IsEnabled="False" />
                    <Button x:Name="SavePcdButton"
                            Grid.Column="3"
                            Content="保存 PCD…"
                            IsEnabled="False" />
                    <Button x:Name="ResetButton"
                            Grid.Column="4"
                            Content="重置视角" />

                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PointSizeLabel" Text="点大小"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Slider x:Name="PointSizeSlider"
                                Width="120"
                                Minimum="1"
                                Maximum="16"
                                StepFrequency="0.5"
                                Value="3"
                                VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="SpeedLabel" Text="视角速度"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Slider x:Name="SpeedSlider"
                                Width="110"
                                Minimum="0.2"
                                Maximum="3"
                                StepFrequency="0.1"
                                Value="1"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="SpeedText"
                                   Text="1.0×"
                                   Width="42"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="7"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ProgressRing x:Name="BusyRing"
                                      Width="16"
                                      Height="16"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                        <TextBlock x:Name="StatsText"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="尚未加载点云" />
                    </StackPanel>
                </Grid>

                <!-- 点云选择 -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <ToggleButton x:Name="ClusterToggle"
                                  Content="选择点云"
                                  IsEnabled="False" />
                    <TextBlock x:Name="AdjacencyLabel" Text="邻接距离"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Slider x:Name="ClusterRadiusSlider"
                            Width="110"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.01"
                            Value="0.1"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ClusterRadiusText"
                               Text="0.10 m"
                               Width="56"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="RangeLabel" Text="范围"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Slider x:Name="ClusterRangeSlider"
                            Width="110"
                            Minimum="0"
                            Maximum="20"
                            StepFrequency="0.5"
                            Value="3"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ClusterRangeText"
                               Text="3.0 m"
                               Width="56"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Button x:Name="DeleteClusterButton"
                            Content="删除点云"
                            IsEnabled="False" />
                    <TextBlock x:Name="ClusterHintText"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="点击点云选中连通的一片；左键拖动转视角" />
                </StackPanel>

                <!-- 聚类选区的 XYZ 边界控制（选中点云后显示） -->
                <StackPanel x:Name="BoundaryPanel"
                            Orientation="Vertical"
                            Spacing="2"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="X" Width="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BoundaryXMinLabel" Text="最小" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="BoundaryXMinSlider" Width="120" VerticalAlignment="Center" />
                        <TextBlock x:Name="BoundaryXMinText" Width="60" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BoundaryXMaxLabel" Text="最大" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="BoundaryXMaxSlider" Width="120" VerticalAlignment="Center" />
                        <TextBlock x:Name="BoundaryXMaxText" Width="60" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Y" Width="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BoundaryYMinLabel" Text="最小" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="BoundaryYMinSlider" Width="120" VerticalAlignment="Center" />
                        <TextBlock x:Name="BoundaryYMinText" Width="60" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BoundaryYMaxLabel" Text="最大" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="BoundaryYMaxSlider" Width="120" VerticalAlignment="Center" />
                        <TextBlock x:Name="BoundaryYMaxText" Width="60" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Z" Width="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BoundaryZMinLabel" Text="最小" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="BoundaryZMinSlider" Width="120" VerticalAlignment="Center" />
                        <TextBlock x:Name="BoundaryZMinText" Width="60" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BoundaryZMaxLabel" Text="最大" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="BoundaryZMaxSlider" Width="120" VerticalAlignment="Center" />
                        <TextBlock x:Name="BoundaryZMaxText" Width="60" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3D 视口（左侧点云列表、右侧视图/坐标面板都浮在视口上） -->
        <Grid Grid.Row="2"
              x:Name="ViewportHost"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              IsTabStop="True"
              KeyDown="OnViewportKeyDown"
              KeyUp="OnViewportKeyUp"
              LostFocus="OnViewportLostFocus">
            <SwapChainPanel x:Name="Viewport" />

            <TextBlock x:Name="EmptyHint"
                       Text="将 .ply / .pcd 文件拖入窗口，或点击“打开点云文件…”"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsHitTestVisible="False"
                       TextAlignment="Center" />

            <!-- 左上角：点云列表（小面板） -->
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="252"
                    Margin="12"
                    Padding="8"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="CloudListTitle" Text="点云列表"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CloudListPanel" Spacing="4" />
                    </ScrollViewer>
                    <TextBlock x:Name="CloudListHint" Text="勾选可同时显示多个点云；点击名称切换当前编辑的点云"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 左下角：操作提示 -->
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="12"
                    Padding="8,4"
                    CornerRadius="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ControlsHint" Text="左键拖动：按拖动方向转动视角    右键 / 中键拖动：平移    滚轮：前进 / 后退    W / S：前进 / 后退    A / D：左移 / 右移    Q / E：上升 / 下降"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>

                <!-- 右侧视图切换：俯/仰、前/后、左/右 -->
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="12"
                            Spacing="8">
                    <!-- 视图切换 -->
                    <Border Padding="8"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="ViewPanelTitle" Text="视图"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ViewTopButton" Content="俯视" Width="64" Click="OnViewTopClick" />
                                <Button x:Name="ViewBottomButton" Content="仰视" Width="64" Click="OnViewBottomClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ViewFrontButton" Content="前视" Width="64" Click="OnViewFrontClick" />
                                <Button x:Name="ViewBackButton" Content="后视" Width="64" Click="OnViewBackClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ViewLeftButton" Content="左视" Width="64" Click="OnViewLeftClick" />
                                <Button x:Name="ViewRightButton" Content="右视" Width="64" Click="OnViewRightClick" />
                            </StackPanel>
                            <ToggleButton x:Name="AxesToggle"
                                          Content="显示坐标轴"
                                          IsChecked="True"
                                          HorizontalAlignment="Stretch"
                                          Click="OnAxesToggleClick" />
                        </StackPanel>
                    </Border>

                    <!-- 点云坐标调整 -->
                    <Border Padding="8"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="TransformPanelTitle" Text="坐标调整"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="StepLabel" Text="步长"
                                           Width="40"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBox x:Name="TranslationStepBox"
                                         Width="96"
                                         Text="0.1" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="AngleLabel" Text="角度"
                                           Width="40"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBox x:Name="RotationStepBox"
                                         Width="96"
                                         Text="5" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="X" Width="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="−" Width="28" Height="28" Padding="0" Click="OnTransformXMinusClick" />
                                <TextBlock x:Name="TransformXText" Text="0.00" Width="56" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="＋" Width="28" Height="28" Padding="0" Click="OnTransformXPlusClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Y" Width="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="−" Width="28" Height="28" Padding="0" Click="OnTransformYMinusClick" />
                                <TextBlock x:Name="TransformYText" Text="0.00" Width="56" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="＋" Width="28" Height="28" Padding="0" Click="OnTransformYPlusClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Z" Width="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="−" Width="28" Height="28" Padding="0" Click="OnTransformZMinusClick" />
                                <TextBlock x:Name="TransformZText" Text="0.00" Width="56" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="＋" Width="28" Height="28" Padding="0" Click="OnTransformZPlusClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="RX" Width="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="−" Width="28" Height="28" Padding="0" Click="OnTransformRXMinusClick" />
                                <TextBlock x:Name="TransformRXText" Text="0°" Width="56" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="＋" Width="28" Height="28" Padding="0" Click="OnTransformRXPlusClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="RY" Width="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="−" Width="28" Height="28" Padding="0" Click="OnTransformRYMinusClick" />
                                <TextBlock x:Name="TransformRYText" Text="0°" Width="56" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="＋" Width="28" Height="28" Padding="0" Click="OnTransformRYPlusClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="RZ" Width="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="−" Width="28" Height="28" Padding="0" Click="OnTransformRZMinusClick" />
                                <TextBlock x:Name="TransformRZText" Text="0°" Width="56" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button Content="＋" Width="28" Height="28" Padding="0" Click="OnTransformRZPlusClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 坐标轴指示：X 红、Y 绿、Z 蓝 -->
                <Canvas x:Name="AxisGizmo"
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        IsHitTestVisible="False">
                    <Line x:Name="AxisLineX" X1="48" Y1="48" X2="48" Y2="34" Stroke="#FFFF6B6B" StrokeThickness="2" />
                    <Line x:Name="AxisLineY" X1="48" Y1="48" X2="48" Y2="34" Stroke="#FF6BFF8B" StrokeThickness="2" />
                    <Line x:Name="AxisLineZ" X1="48" Y1="48" X2="48" Y2="34" Stroke="#FF6BB5FF" StrokeThickness="2" />
                    <TextBlock x:Name="AxisLabelX" Text="X" Foreground="#FFFF6B6B" FontSize="11" />
                    <TextBlock x:Name="AxisLabelY" Text="Y" Foreground="#FF6BFF8B" FontSize="11" />
                    <TextBlock x:Name="AxisLabelZ" Text="Z" Foreground="#FF6BB5FF" FontSize="11" />
                </Canvas>
            </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3"
                Padding="12,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Text="就绪"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
